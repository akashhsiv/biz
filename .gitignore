# .NET
backend/**/bin/
backend/**/obj/
backend/**/chromium-cache/

# Local secrets — never commit real credentials
backend/src/Erp.Api/appsettings.Development.json
backend/src/Erp.Api/appsettings.Production.json
backend/secrets/
