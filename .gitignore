# Node (WhatsApp bridge)
whatsapp-service/node_modules/
whatsapp-service/auth-session/

# Build outputs — staged/compiled by deploy/build-release.ps1 and NSIS, never source
deploy/dist/
deploy/host/*.exe
deploy/client/*.exe
frontend/build/
frontend/windows/flutter/ephemeral/

# Backups (should never be committed regardless of configured destination)
*.dump

# Editor/OS
.vs/
.vscode/
*.user
Thumbs.db
